{
  "examples": [
    {
      "label": "Example 1",
      "input": "4\n4 9 1 6\n7",
      "expected": "2 3",
      "display": "nums   = [4, 9, 1, 6]\ntarget = 7\noutput = [2, 3]"
    },
    {
      "label": "Example 2",
      "input": "4\n8 -2 5 3\n6",
      "expected": "0 1",
      "display": "nums   = [8, -2, 5, 3]\ntarget = 6\noutput = [0, 1]"
    }
  ],
  "edge": [
    { "label": "Edge 1: two equal values", "input": "2\n6 6\n12", "expected": "0 1" },
    { "label": "Edge 2: zeros", "input": "4\n7 0 2 0\n0", "expected": "1 3" },
    { "label": "Edge 3: negatives", "input": "5\n-5 12 -8 3 20\n-13", "expected": "0 2" },
    { "label": "Edge 4: pair at both ends", "input": "5\n1 50 60 70 9\n10", "expected": "0 4" },
    { "label": "Edge 5: large values", "input": "3\n1000000000 -999999999 5\n1", "expected": "0 1" }
  ]
}
