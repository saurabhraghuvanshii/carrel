{
  "examples": [
    {
      "label": "Example 1",
      "input": "4\n3 5 7 9\n1",
      "expected": "true",
      "display": "list   = 3 -> 5 -> 7 -> 9 -> back to 5\noutput = true"
    },
    {
      "label": "Example 2",
      "input": "2\n1 2\n-1",
      "expected": "false",
      "display": "list   = 1 -> 2\noutput = false"
    }
  ],
  "edge": [
    { "label": "Edge 1: one node pointing to itself", "input": "1\n4\n0", "expected": "true" },
    { "label": "Edge 2: one node, no loop", "input": "1\n4\n-1", "expected": "false" },
    { "label": "Edge 3: empty list", "input": "0\n\n-1", "expected": "false" }
  ]
}
