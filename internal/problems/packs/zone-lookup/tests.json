{
  "examples": [
    {
      "label": "Example 1",
      "input": "3 6\n4000 4099 3\n1000 1999 1\n2000 2500 2\n1500 2500 2501 4000 999 5000",
      "expected": "[1, 2, -1, 3, -1, -1]",
      "display": "ranges = [[4000, 4099, 3], [1000, 1999, 1], [2000, 2500, 2]]\ncodes  = [1500, 2500, 2501, 4000, 999, 5000]\noutput = [1, 2, -1, 3, -1, -1]\n\n2500 is the last code of zone 2; 2501 falls in the gap before 4000."
    },
    {
      "label": "Example 2",
      "input": "1 2\n7 7 9\n7 8",
      "expected": "[9, -1]",
      "display": "ranges = [[7, 7, 9]]\ncodes  = [7, 8]\noutput = [9, -1]\n\nA range can hold a single code."
    }
  ],
  "edge": [
    { "label": "Edge 1: ranges side by side", "input": "2 4\n20 29 2\n10 19 1\n19 20 9 30", "expected": "[1, 2, -1, -1]" },
    { "label": "Edge 2: two ranges of one zone", "input": "2 3\n1 2 5\n8 9 5\n2 5 8", "expected": "[5, -1, 5]" },
    { "label": "Edge 3: code 0 and the largest code", "input": "2 3\n0 0 4\n1000000000 1000000000 6\n0 1000000000 1", "expected": "[4, 6, -1]" },
    { "label": "Edge 4: a code below every range", "input": "1 1\n50 60 1\n10", "expected": "[-1]" }
  ]
}
