{
  "examples": [
    {
      "label": "Example 1",
      "input": "6\n3 -1 0 2 -2 1\n1",
      "expected": "[[-2, 0, 3], [-2, 1, 2], [-1, 0, 2]]",
      "display": "nums   = [3, -1, 0, 2, -2, 1]\ntarget = 1\noutput = [[-2, 0, 3], [-2, 1, 2], [-1, 0, 2]]"
    },
    {
      "label": "Example 2",
      "input": "4\n4 4 4 1\n12",
      "expected": "[[4, 4, 4]]",
      "display": "nums   = [4, 4, 4, 1]\ntarget = 12\noutput = [[4, 4, 4]]"
    }
  ],
  "edge": [
    { "label": "Edge 1: no triple", "input": "3\n1 2 3\n7", "expected": "[]" },
    { "label": "Edge 2: one value many times", "input": "5\n0 0 0 0 0\n0", "expected": "[[0, 0, 0]]" },
    { "label": "Edge 3: a value used twice", "input": "4\n2 2 1 5\n5", "expected": "[[1, 2, 2]]" }
  ]
}
