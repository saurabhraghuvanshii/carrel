{
  "examples": [
    {
      "label": "Example 1",
      "input": "3\n3 4 2\n2\n8 6",
      "expected": "[1, 1, 3]",
      "display": "first  = 3 -> 4 -> 2   (243)\nsecond = 8 -> 6        (68)\noutput = 1 -> 1 -> 3   (311)"
    },
    {
      "label": "Example 2",
      "input": "2\n9 9\n1\n1",
      "expected": "[0, 0, 1]",
      "display": "first  = 9 -> 9        (99)\nsecond = 1             (1)\noutput = 0 -> 0 -> 1   (100)"
    }
  ],
  "edge": [
    { "label": "Edge 1: both zero", "input": "1\n0\n1\n0", "expected": "[0]" },
    { "label": "Edge 2: different lengths", "input": "3\n1 0 1\n1\n9", "expected": "[0, 1, 1]" },
    { "label": "Edge 3: a carry makes a new digit", "input": "1\n5\n1\n5", "expected": "[0, 1]" }
  ]
}
