{
  "examples": [
    {
      "label": "Example 1",
      "input": "6\n1 2 2 2 5 8\n2",
      "expected": "[1, 3]",
      "display": "nums   = [1, 2, 2, 2, 5, 8]\ntarget = 2\noutput = [1, 3]"
    },
    {
      "label": "Example 2",
      "input": "3\n4 4 6\n5",
      "expected": "[-1, -1]",
      "display": "nums   = [4, 4, 6]\ntarget = 5\noutput = [-1, -1]"
    }
  ],
  "edge": [
    { "label": "Edge 1: every value is the target", "input": "4\n7 7 7 7\n7", "expected": "[0, 3]" },
    { "label": "Edge 2: empty list", "input": "0\n\n3", "expected": "[-1, -1]" },
    { "label": "Edge 3: one value", "input": "1\n9\n9", "expected": "[0, 0]" }
  ]
}
