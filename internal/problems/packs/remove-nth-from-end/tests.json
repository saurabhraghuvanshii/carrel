{
  "examples": [
    {
      "label": "Example 1",
      "input": "5\n4 8 15 16 23\n2",
      "expected": "[4, 8, 15, 23]",
      "display": "list   = 4 -> 8 -> 15 -> 16 -> 23\nn      = 2\noutput = 4 -> 8 -> 15 -> 23"
    },
    {
      "label": "Example 2",
      "input": "2\n7 8\n2",
      "expected": "[8]",
      "display": "list   = 7 -> 8\nn      = 2\noutput = 8\n\nThe first node is removed."
    }
  ],
  "edge": [
    { "label": "Edge 1: the only node", "input": "1\n5\n1", "expected": "[]" },
    { "label": "Edge 2: the last node", "input": "3\n1 2 3\n1", "expected": "[1, 2]" },
    { "label": "Edge 3: equal values", "input": "3\n2 2 2\n2", "expected": "[2, 2]" }
  ]
}
