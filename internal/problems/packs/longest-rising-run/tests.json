{
  "examples": [
    {
      "label": "Example 1",
      "input": "6\n3 1 8 2 5 9",
      "expected": "4",
      "display": "nums   = [3, 1, 8, 2, 5, 9]\noutput = 4\n\nFor example 1, 2, 5, 9."
    },
    {
      "label": "Example 2",
      "input": "3\n4 4 4",
      "expected": "1",
      "display": "nums   = [4, 4, 4]\noutput = 1\n\nEqual values do not count as rising."
    }
  ],
  "edge": [
    { "label": "Edge 1: one value", "input": "1\n7", "expected": "1" },
    { "label": "Edge 2: falling", "input": "4\n5 4 3 2", "expected": "1" },
    { "label": "Edge 3: a repeat in the middle", "input": "4\n1 2 2 3", "expected": "3" },
    { "label": "Edge 4: negative values", "input": "4\n-3 -1 -2 0", "expected": "3" }
  ]
}
