{
  "examples": [
    {
      "label": "Example 1",
      "input": "3 3\n4 9 2\n3 5 7\n8 1 6",
      "expected": "[[8, 3, 4], [1, 5, 9], [6, 7, 2]]",
      "display": "grid   = 4 9 2        output = 8 3 4\n         3 5 7                 1 5 9\n         8 1 6                 6 7 2"
    },
    {
      "label": "Example 2",
      "input": "2 2\n0 -1\n5 2",
      "expected": "[[5, 0], [2, -1]]",
      "display": "grid   = 0 -1         output = 5  0\n         5  2                  2 -1"
    }
  ],
  "edge": [
    { "label": "Edge 1: one cell", "input": "1 1\n7", "expected": "[[7]]" },
    { "label": "Edge 2: four by four", "input": "4 4\n0 1 0 1\n2 0 2 0\n3 3 0 0\n0 0 4 4", "expected": "[[0, 3, 2, 0], [0, 3, 0, 1], [4, 0, 2, 0], [4, 0, 0, 1]]" },
    { "label": "Edge 3: negative values", "input": "2 2\n-1 -2\n-3 -4", "expected": "[[-3, -1], [-4, -2]]" }
  ]
