{
  "examples": [
    {
      "label": "Example 1",
      "input": "5\n5 2 -3 1 4",
      "expected": "3",
      "display": "nums   = [5, 2, -3, 1, 4]\noutput = 3"
    },
    {
      "label": "Example 2",
      "input": "3\n2 3 4",
      "expected": "1",
      "display": "nums   = [2, 3, 4]\noutput = 1"
    }
  ],
  "edge": [
    { "label": "Edge 1: every value from 1 to n", "input": "4\n4 2 3 1", "expected": "5" },
    { "label": "Edge 2: zeros and repeats", "input": "5\n0 1 1 0 2", "expected": "3" },
    { "label": "Edge 3: only far values", "input": "2\n1000000000 -1000000000", "expected": "1" },
    { "label": "Edge 4: just 1", "input": "1\n1", "expected": "2" }
  ]
}
