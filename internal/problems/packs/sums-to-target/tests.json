    },
    {
      "label": "Example 2",
      "input": "1\n6\n4",
      "expected": "[]",
      "display": "candidates = [6]\ntarget     = 4\noutput     = []"
    }
  ],
  "edge": [
    { "label": "Edge 1: the target is a candidate", "input": "1\n5\n5", "expected": "[[5]]" },
    { "label": "Edge 2: reuse needed", "input": "2\n2 3\n6", "expected": "[[2, 2, 2], [3, 3]]" },
    { "label": "Edge 3: ones", "input": "1\n1\n3", "expected": "[[1, 1, 1]]" }
  ]
