{
  "examples": [
    {
      "label": "Example 1",
      "input": "5\n8 3 5 3 9",
      "expected": "true",
      "display": "nums   = [8, 3, 5, 3, 9]\noutput = true\n\n3 appears twice."
    },
    {
      "label": "Example 2",
      "input": "4\n12 -4 7 0",
      "expected": "false",
      "display": "nums   = [12, -4, 7, 0]\noutput = false"
    }
  ],
  "edge": [
    { "label": "Edge 1: one value", "input": "1\n42", "expected": "false" },
    { "label": "Edge 2: repeat at both ends", "input": "4\n6 1 2 6", "expected": "true" },
    { "label": "Edge 3: largest and smallest values", "input": "3\n1000000000 -1000000000 999999999", "expected": "false" },
    { "label": "Edge 4: negative repeat", "input": "3\n-5 -5 -6", "expected": "true" }
  ]
}
