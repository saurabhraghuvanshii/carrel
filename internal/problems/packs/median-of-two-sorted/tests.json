{
  "examples": [
    {
      "label": "Example 1",
      "input": "3\n1 5 9\n2\n2 6",
      "expected": "5.0",
      "display": "first  = [1, 5, 9]\nsecond = [2, 6]\noutput = 5.0"
    },
    {
      "label": "Example 2",
      "input": "2\n4 8\n2\n1 3",
      "expected": "3.5",
      "display": "first  = [4, 8]\nsecond = [1, 3]\noutput = 3.5\n\nAll values: [1, 3, 4, 8]; the middle two are 3 and 4."
    }
  ],
  "edge": [
    { "label": "Edge 1: first list empty", "input": "0\n\n1\n7", "expected": "7.0" },
    { "label": "Edge 2: all equal", "input": "2\n2 2\n2\n2 2", "expected": "2.0" },
    { "label": "Edge 3: negative half", "input": "1\n-5\n1\n-6", "expected": "-5.5" },
    { "label": "Edge 4: lists that do not overlap", "input": "3\n1 2 3\n3\n10 11 12", "expected": "6.5" }
  ]
}
