{
  "examples": [
    {
      "label": "Example 1",
      "input": "3\n9 10\n13 15\n10 12",
      "expected": "true",
      "display": "meetings  = [[9, 10], [13, 15], [10, 12]]\noutput    = true\n\nIn order: 9-10, 10-12, 13-15. The first two only touch."
    },
    {
      "label": "Example 2",
      "input": "2\n8 11\n10 13",
      "expected": "false",
      "display": "meetings  = [[8, 11], [10, 13]]\noutput    = false"
    }
  ],
  "edge": [
    { "label": "Edge 1: no meetings", "input": "0", "expected": "true" },
    { "label": "Edge 2: one meeting", "input": "1\n3 4", "expected": "true" },
    { "label": "Edge 3: one meeting inside another", "input": "2\n1 5\n2 3", "expected": "false" },
    { "label": "Edge 4: touching, given out of order", "input": "2\n5 6\n1 5", "expected": "true" }
  ]
}
