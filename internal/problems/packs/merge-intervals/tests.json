{
  "examples": [
    {
      "label": "Example 1",
      "input": "4\n4 7\n1 2\n6 9\n11 12",
      "expected": "[[1, 2], [4, 9], [11, 12]]",
      "display": "intervals = [[4, 7], [1, 2], [6, 9], [11, 12]]\noutput    = [[1, 2], [4, 9], [11, 12]]"
    },
    {
      "label": "Example 2",
      "input": "2\n3 5\n5 8",
      "expected": "[[3, 8]]",
      "display": "intervals = [[3, 5], [5, 8]]\noutput    = [[3, 8]]\n\nTouching intervals merge."
    }
  ],
  "edge": [
    { "label": "Edge 1: one interval", "input": "1\n2 3", "expected": "[[2, 3]]" },
    { "label": "Edge 2: one inside another", "input": "2\n1 10\n2 3", "expected": "[[1, 10]]" },
    { "label": "Edge 3: close but not touching", "input": "3\n6 8\n1 2\n3 4", "expected": "[[1, 2], [3, 4], [6, 8]]" }
  ]
}
